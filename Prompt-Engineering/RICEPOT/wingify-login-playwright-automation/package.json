    "report:open": "allure open allure-report"
  },
  "dependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "cross-env": "^7.0.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
